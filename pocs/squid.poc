5] Debug squid with various checks
root@squid:~# ip -br -4 a
lo               UNKNOWN        127.0.0.1/8
eth0             DOWN           10.0.2.15/24
eth1             UP             192.168.1.210/24
tun0             UNKNOWN        192.168.2.2/24

root@squid:~# resolvconf -l
# resolv.conf from lo.unbound
nameserver 127.0.0.1

# resolv.conf from tun0.openvpn
nameserver 8.8.8.8
nameserver 8.8.4.4

# resolv.conf from eth0
# resolv.conf for eth0
domain home
nameserver 10.0.2.3

root@squid:~# ip link show
1: lo: <LOOPBACK,UP,LOWER_UP> mtu 65536 qdisc noqueue state UNKNOWN mode DEFAULT group default qlen 1000
    link/loopback 00:00:00:00:00:00 brd 00:00:00:00:00:00
2: eth0: <BROADCAST,MULTICAST> mtu 1500 qdisc fq_codel state DOWN mode DEFAULT group default qlen 1000
    link/ether 08:00:27:8d:c0:4d brd ff:ff:ff:ff:ff:ff
    altname enp0s3
3: eth1: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 1500 qdisc fq_codel state UP mode DEFAULT group default qlen 1000
    link/ether 08:00:27:44:32:c8 brd ff:ff:ff:ff:ff:ff
    altname enp0s8
4: tun0: <POINTOPOINT,MULTICAST,NOARP,UP,LOWER_UP> mtu 1500 qdisc fq_codel state UNKNOWN mode DEFAULT group default qlen 500
    link/none

root@squid:~# ip route
default via 192.168.2.2 dev tun0
192.168.1.0/24 dev eth1 proto kernel scope link src 192.168.1.210
192.168.2.0/24 dev tun0 proto kernel scope link src 192.168.2.2

root@squid:~# cat /etc/openvpn/client.conf
client
dev tun
proto udp
remote openvpn.vagrant-dummy-ops.lab 1194
cipher AES-256-GCM
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
auth SHA256
#remote-cert-tls server
tls-client
ca /usr/local/share/ca-certificates/vagrant_ca.crt
cert /etc/ssl/localcerts/vagrant_openvpn-client.crt
key /etc/ssl/localcerts/vagrant_openvpn-client.key
verb 3

# apt install openresolv
# This will replace /etc/resolv.conf with the DNS server pushed by the OpenVPN server (10.0.2.3).
script-security 2
up /etc/openvpn/update-resolv-conf
down /etc/openvpn/update-resolv-conf

#route 10.0.2.0 255.255.255.0
root@squid:~#
