dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
# Allow rootDSE
olcAccess: {0}to dn.base="" by * read
olcAccess: {1}to dn.children="dc=vagrant-dummy-ops,dc=lab" by * read
# Protect userPassword
olcAccess: {2}to attrs=userPassword by self auth by * none
# Allow nslcd-client read typical account attributes
olcAccess: {3}to attrs=uid,uidNumber,gidNumber,homeDirectory,loginShell,cn,sn
  by dn.exact="cn=nslcd-client,ou=services,ou=it,dc=vagrant-dummy-ops,dc=lab" read
  by * none
olcAccess: {4}to * by dn.exact="cn=nslcd_guest,ou=services,ou=it,dc=vagrant-dummy-ops,dc=lab" read by * none
# Default deny everything else
olcAccess: {5}to * by * none
