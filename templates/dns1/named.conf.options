options {
	directory "/var/cache/bind";

	forwarders {
	  8.8.8.8;
    8.8.4.4;
	};

	dnssec-validation auto;
  listen-on port 53 {192.168.1.200;};
	listen-on-v6 { any; };
  allow-query {192.168.1.0/24;};
  // recursion is set to 'yes' by default
  recursion yes;
  allow-recursion {192.168.1.200;192.168.1.201;};
  allow-transfer {192.168.1.201;};
  also-notify { 192.168.1.201; };
};
