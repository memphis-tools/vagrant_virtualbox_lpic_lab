$TTL	604800
@	IN	SOA	dns1.vagrant-dummy-ops.lab. shijuro.dovecot.vagrant-dummy-ops.lab. (
			 2		  ; Serial
			 3600	  ; Refresh
			 1800		; Retry
			 1209600		; Expire
			 604800 )	; Negative Cache TTL
;
@	IN	NS	dns1.vagrant-dummy-ops.lab.
@	IN	NS	dns2.vagrant-dummy-ops.lab.

@	IN	MX	10 dovecot.vagrant-dummy-ops.lab.

@	IN	A	192.168.1.200
@	IN	A	192.168.1.201
@	IN	A	192.168.1.202
@	IN	A	192.168.1.203
@	IN	A	192.168.1.204
@	IN	A	192.168.1.205
@	IN	A	192.168.1.206
@	IN	A	192.168.1.207
@	IN	A	192.168.1.208
@	IN	A	192.168.1.209
@	IN	A	192.168.1.210
@	IN	A	192.168.1.211
@	IN	A	192.168.1.212
@	IN	A	192.168.1.213
@	IN	A	192.168.1.214
@	IN	A	192.168.1.216
@	IN	A	192.168.1.217

dns1	IN	A	192.168.1.200
dns2	IN	A	192.168.1.201
vsftp	IN	A	192.168.1.202
nas-san	IN	A	192.168.1.203
maven	IN	A	192.168.1.204
tomcat	IN	A	192.168.1.205
dovecot	IN	A	192.168.1.206
kdc IN	A	192.168.1.207
ansible IN	A	192.168.1.208
analyzer IN	A	192.168.1.209
squid IN	A	192.168.1.210
openldap IN	A	192.168.1.211
apache IN	A	192.168.1.212
nginx IN	A	192.168.1.213
openvpn IN	A	192.168.1.214
bastion IN	A	192.168.1.216
bacula IN	A	192.168.1.217

tomcat-alias	IN	CNAME	tomcat
